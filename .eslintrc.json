{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "overrides": [],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react", "@typescript-eslint"],
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression[callee.object.name='console'] > MemberExpression[property.name=/^(response|config|request)$/]",
        "message": "A failed request's response, config or request carries the participant's bearer token and request body. Use logRequestFailure from api/errorMessages instead."
      }
    ]
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
